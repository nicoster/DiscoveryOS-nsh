{
  "name": "DiscoveryOS",
  "id": "com.nickr.DiscoveryOS",
  "version": "1.0.3",
  "build": 4,
  "rust": ".",
  "capabilities": {
    "network": {
      "hosts": [
        "www.4d4y.com",
        "*.4d4y.com",
        "*.bilibili.com",
        "b23.tv",
        "bili2233.cn",
        "*.hdslb.com",
        "*.bilivideo.com",
        "*.douyin.com",
        "*.iesdouyin.com",
        "*.douyinvod.com",
        "*.douyinpic.com",
        "*.douyinstatic.com",
        "*.byteimg.com",
        "*.bytecdn.cn",
        "*.snssdk.com",
        "*.pstatp.com",
        "*.zijieapi.com",
        "github.com",
        "*.githubusercontent.com"
      ]
    },
    "webview": {
      "hosts": [
        "*.bilibili.com",
        "*.hdslb.com",
        "*.bilivideo.com",
        "*.douyin.com",
        "*.iesdouyin.com",
        "*.douyinvod.com",
        "*.douyinpic.com",
        "*.douyinstatic.com",
        "*.byteimg.com",
        "*.bytecdn.cn",
        "*.snssdk.com",
        "*.pstatp.com",
        "*.zijieapi.com"
      ]
    },
    "openUrl": {
      "schemes": [
        "https"
      ]
    },
    "process": {
      "env": [
        "DEBUG"
      ]
    },
    "fs": {
      "read": [
        "${dataDir}"
      ],
      "write": [
        "${dataDir}"
      ]
    }
  }
}
