        "*.douyinpic.com",
        "*.douyinstatic.com",
        "*.byteimg.com",
        "*.bytecdn.cn",
        "*.snssdk.com",
        "*.pstatp.com",
        "*.zijieapi.com",
        "github.com",
        "*.githubusercontent.com"
      ]
